    "On power": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang cắm sạc"
          }
        }
      }
    },
    "On power adapter": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang cắm sạc"
          }
        }
      }
    },
    "One cycle is using 100% of the battery's capacity, not necessarily in one go.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một chu kỳ là dùng hết 100% dung lượng pin, không nhất thiết trong một lần."
          }
        }
      }
    },
    "Only %@ free. Run Smart Scan to reclaim space.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ còn trống %@. Chạy Smart Scan để giải phóng dung lượng."
          }
        }
      }
    },
    "Only caches and logs that apps rebuild. Emptying the Trash, removing simulators and anything in Downloads always wait for you.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bộ nhớ đệm và log mà app tự tạo lại. Dọn Thùng rác, xoá simulator và mọi thứ trong Downloads luôn chờ bạn quyết định."
          }
        }
      }
    },
    "Only processes running as you are listed. CPU 100% equals one full core.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ liệt kê tiến trình chạy dưới tài khoản của bạn. CPU 100% bằng một nhân đầy tải."
          }
        }
      }
    },
    "Only regenerable caches are deleted. Everything else goes to the Trash and can be restored.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xoá cache có thể tạo lại. Mọi thứ khác vào Thùng rác và khôi phục được."
          }
        }
      }
    },
    "Only regenerable caches are deleted. Everything else goes to the Trash.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xoá cache tạo lại được. Mọi thứ khác vào Thùng rác."
          }
        }
      }
    },
    "Only while connected to power": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khi đang cắm sạc"
          }
        }
      }
    },
    "Open Activity": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Hoạt động"
          }
        }
      }
    },
    "Open Dashboard": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Dashboard"
          }
        }
      }
    },
    "Open Osin at login": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Osin khi đăng nhập"
          }
