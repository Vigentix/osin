          }
        }
      }
    },
    "Your Mac is short on memory. Quit apps you are not using.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy đang thiếu bộ nhớ. Hãy thoát các ứng dụng không dùng."
          }
        }
      }
    },
    "Your battery holds less charge than when new. Consider a service check.": {
