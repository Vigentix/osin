    },
    "%@ free of %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn trống %1$@ / %2$@"
          }
        }
      }
    },
    "%@ freed immediately · %@ moved to Trash (restorable)": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải phóng ngay %1$@ · %2$@ chuyển vào Thùng rác (khôi phục được)"
