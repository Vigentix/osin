    "%@ is waiting and macOS installs updates automatically, so your Mac may restart overnight.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đang chờ cài và macOS đang bật tự cài cập nhật, nên máy có thể tự khởi động lại trong đêm."
