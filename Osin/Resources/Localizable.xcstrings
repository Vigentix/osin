    "%@ / %@ · swap %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@ · swap %3$@"
          }
        }
      }
    },
    "%@ can go safely.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ có thể dọn an toàn."
          }
        }
      }
    },
    "%@ cannot be undone.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không hoàn tác được."
          }
        }
      }
    },
    "%@ finished after %@. Your Mac can sleep again.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã chạy xong sau %@. Máy có thể ngủ lại bình thường."
          }
        }
      }
    },
    "%@ free": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn trống %@"
          }
