        }
      }
    },
    "%@ is open, so %@ is left out. Quit it, then check again.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang mở nên %2$@ chưa được tính. Hãy thoát app rồi kiểm tra lại."
