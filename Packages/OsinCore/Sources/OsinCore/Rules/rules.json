      },
      {
        "app": "Notion.app",
        "folder": "~/Library/Application Support/Notion"
      }
    ]
  },
  {
    "id": "app.pending-updates",
    "name": "Downloaded app updates",
    "detail": "Updates that apps downloaded but have not installed yet. They go to the Trash; apps download them again when needed.",
    "tier": "review",
    "action": "trash",
    "regenerable": true,
    "paths": [
      "~/Library/Caches/*.ShipIt",
      "~/Library/Caches/*-updater"
    ]
  },
  {
    "id": "browser.chrome-ai-model",
    "name": "Chrome's on-device AI model",
    "detail": "The model behind Chrome's built-in AI features. Chrome downloads it again if you use them.",
    "tier": "review",
    "action": "trash",
    "regenerable": true,
    "paths": [
      "~/Library/Application Support/Google/Chrome/OptGuideOnDeviceModel/*"
    ],
    "closedApps": [
      {
        "app": "Google Chrome.app",
        "folder": "~/Library/Application Support/Google/Chrome"
      }
    ]
  },
  {
    "id": "dev.cold-projects",
    "name": "Cold projects",
    "detail": "Dependencies and build output (node_modules, .venv, target, .next, Pods…) of projects with no commits or edits for 30 days. Reinstall with your package manager when you return.",
    "tier": "review",
    "action": "trash",
    "regenerable": true,
    "paths": [],
    "find": {
      "roots": [
        "~/Projects",
        "~/Developer",
        "~/Code",
        "~/code",
        "~/src",
        "~/dev",
        "~/workspace",
        "~/repos",
        "~/git",
        "~/GitHub"
      ],
      "targets": [
        {
          "name": "node_modules"
        },
        {
          "name": ".venv",
          "inside": "pyvenv.cfg"
        },
        {
          "name": "venv",
          "inside": "pyvenv.cfg"
        },
        {
          "name": "target",
          "sibling": "Cargo.toml"
        },
        {
          "name": ".next",
          "sibling": "package.json"
        },
        {
          "name": ".nuxt",
          "sibling": "package.json"
        },
        {
          "name": ".turbo",
          "sibling": "package.json"
        },
        {
          "name": "Pods",
          "sibling": "Podfile"
        },
        {
          "name": ".gradle",
          "sibling": "settings.gradle*"
        }
      ],
      "maxDepth": 5,
      "coldDays": 30,
      "includeProjectRoots": true
    }
  },
  {
    "id": "dev.toolchains",
    "name": "Unused toolchains",
    "detail": "Node, Python and Rust versions installed with nvm, pyenv or rustup that neither your default nor any project uses.",
    "tier": "review",
    "action": "trash",
    "regenerable": true,
    "paths": [
      "~/.nvm/versions/node/*",
      "~/.pyenv/versions/*",
      "~/.rustup/toolchains/*"
    ],
    "special": "unusedToolchains"
  },
  {
    "id": "ai.agent-sessions",
    "name": "Old AI agent sessions",
    "detail": "Claude Code and Codex conversation logs not touched for 90 days. Settings, skills and plugins are kept.",
    "tier": "review",
    "action": "trash",
    "regenerable": false,
    "paths": [
      "~/.claude/projects/*/*.jsonl",
      "~/.codex/sessions/*/*/*/*.jsonl"
    ],
    "minAgeDays": 90
  },
  {
    "id": "downloads.installers",
    "name": "Installers",
    "detail": "Disk images and installer packages in Downloads.",
    "tier": "review",
    "action": "trash",
    "regenerable": false,
    "paths": [
      "~/Downloads/*.dmg",
      "~/Downloads/*.pkg",
      "~/Downloads/*.mpkg",
      "~/Downloads/*.xip"
    ]
  },
  {
    "id": "downloads.old",
    "name": "Old downloads",
    "detail": "Files in Downloads not modified for 30 days.",
    "tier": "review",
    "action": "trash",
    "regenerable": false,
    "paths": [
      "~/Downloads/*"
    ],
    "minAgeDays": 30
  },
  {
    "id": "xcode.archives",
    "name": "Old Xcode archives",
    "detail": "App archives older than 180 days. They contain debug symbols needed to read old crash reports.",
    "tier": "review",
    "action": "trash",
    "regenerable": false,
    "paths": [
      "~/Library/Developer/Xcode/Archives/*"
    ],
    "minAgeDays": 180
  },
  {
    "id": "ios.backups",
    "name": "Old iPhone and iPad backups",
    "detail": "Device backups not updated for 180 days. Make sure you no longer need them.",
    "tier": "review",
    "action": "trash",
    "regenerable": false,
    "paths": [
      "~/Library/Application Support/MobileSync/Backup/*"
    ],
    "minAgeDays": 180,
    "requiresFullDiskAccess": true
  }
]
